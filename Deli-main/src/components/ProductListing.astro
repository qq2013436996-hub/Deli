---
export type ProductCard = {
  title: string | null
  slug: string
  imageUrl: string | null
  imageAlt: string | null
  categoryName: string | null
  price: number | null
  updatedAt?: string | null
}

interface Props {
  products: ProductCard[]
  /** When false, hides the centered “Featured Products” intro (e.g. category page already has an H1). */
  showPageHeader?: boolean
  /** Tighter top padding when nested under another page title */
  compact?: boolean
  sectionTitle?: string
  sectionDescription?: string
}

const {
  products,
  showPageHeader = true,
  compact = false,
  sectionTitle = 'Featured Products',
  sectionDescription = 'Explore our high-performance LED lighting solutions designed for heavy-duty applications.',
} = Astro.props
---

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
  }
  .container.compact {
    padding-top: 24px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 50px;
  }
  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 10px 0;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }
  .page-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
  }

  .product-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    border-color: transparent;
  }

  .card-image-wrapper {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding: 26px;
    height: 210px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border-color);
    position: relative;
  }
  .card-image-wrapper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
    filter: saturate(1.02);
  }
  .product-card:hover .card-image-wrapper img {
    transform: scale(1.05);
  }

  .card-content {
    padding: 24px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .category-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary-color);
    font-weight: 700;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 70%;
  }

  .update-tag {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 650;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    padding: 4px 10px;
    background: #fff;
    white-space: nowrap;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 16px 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-price {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .card-action {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px dashed var(--border-color);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }
  .product-card:hover .card-action {
    color: var(--primary-color);
  }
  .card-action::after {
    content: '→';
    margin-left: 8px;
    transition: transform 0.2s ease;
  }
  .product-card:hover .card-action::after {
    transform: translateX(4px);
  }

  .empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: 3rem 1rem;
    grid-column: 1 / -1;
  }
</style>

<main class:list={['container', {compact}]}>
  {
    showPageHeader && (
      <header class="page-header">
        <h1>{sectionTitle}</h1>
        <p>{sectionDescription}</p>
      </header>
    )
  }

  <div class="product-grid">
    {
      products.length ? (
        products.map((product) => (
          <a href={`/products/${product.slug}`} class="product-card">
            <div class="card-image-wrapper">
              {product.imageUrl ? (
                <img
                  src={product.imageUrl}
                  alt={product.imageAlt ?? product.title ?? 'Product'}
                  loading="lazy"
                />
              ) : (
                <div style="color: #ccc; font-size: 0.9rem;">No Image</div>
              )}
            </div>

            <div class="card-content">
              <div class="meta-row">
                <span class="category-tag">{product.categoryName || 'Uncategorized'}</span>
                {product.updatedAt ? (
                  <span class="update-tag">
                    Updated {new Date(product.updatedAt).toLocaleDateString()}
                  </span>
                ) : null}
              </div>
              <h2 class="card-title">{product.title}</h2>

              <div class="card-price">
                {typeof product.price === 'number' ? `$${product.price}` : 'Contact for Price'}
              </div>

              <div class="card-action">View Details</div>
            </div>
          </a>
        ))
      ) : (
        <p class="empty-state">
          No products yet. Create and publish products in Sanity Studio, then refresh this page.
        </p>
      )
    }
  </div>
</main>
