---
import {sanityClient} from 'sanity:client'
import MainLayout from '../layouts/MainLayout.astro'
import {assignCategoryPathSlugs} from '../lib/slugify'
import type {ProductCard} from '../components/ProductListing.astro'
import ProductListing from '../components/ProductListing.astro'

type CategoryRow = {
  title: string | null
  slug: string | null
  imageUrl: string | null
  description: string | null
  count: number | null
}

type SettingsRow = {
  companyName: string | null
  companyDescription: string | null
  logoUrl: string | null
  primaryColor: string | null
}

const settings = await sanityClient.fetch<SettingsRow | null>(`*[_type=="siteSettings"][0]{
  companyName,
  companyDescription,
  primaryColor,
  "logoUrl": logo.asset->url
}`)

const heroTitle = settings?.companyName?.trim() || 'Car Light'
const heroSubtitle =
  settings?.companyDescription?.trim() ||
  'Professional automotive LED lighting—work lights, driving lights, warning lights, and OEM/ODM solutions for B2B partners.'

const categoriesRaw = await sanityClient.fetch<CategoryRow[]>(
  `*[_type == "productCategory"] | order(title asc) {
    title,
    "slug": slug.current,
    "imageUrl": image.asset->url,
    description,
    "count": count(*[_type=="product" && defined(slug.current) && references(^._id)])
  }`,
)

const categories = assignCategoryPathSlugs(categoriesRaw ?? [])

type ProductRow = {
  title: string | null
  slug: string | null
  imageUrl: string | null
  imageAlt: string | null
  categoryName: string | null
  price: number | null
  updatedAt: string | null
}

const featuredProductsRaw = await sanityClient.fetch<ProductRow[]>(
  `*[_type=="product" && defined(slug.current)] | order(_updatedAt desc)[0...6]{
    title,
    "slug": slug.current,
    "imageUrl": mainImage.asset->url,
    "imageAlt": mainImage.alt,
    "categoryName": category->title,
    price,
    "updatedAt": _updatedAt
  }`,
)

const featuredProducts: ProductCard[] = (featuredProductsRaw ?? [])
  .filter((p): p is ProductRow & {slug: string} => typeof p.slug === 'string' && p.slug.length > 0)
  .map((p) => ({
    title: p.title,
    slug: p.slug,
    imageUrl: p.imageUrl,
    imageAlt: p.imageAlt,
    categoryName: p.categoryName,
    price: p.price ?? null,
    updatedAt: p.updatedAt ?? null,
  }))
---

<MainLayout title={`${heroTitle} | Automotive LED Lighting`}>
  <style>
    .hero-wrap {
      background:
        radial-gradient(
          1200px 560px at 14% 4%,
          color-mix(in srgb, var(--primary-color) 10%, transparent),
          transparent 58%
        ),
        linear-gradient(180deg, #fffaf9 0%, #ffffff 42%, #f8fafc 100%);
      border-bottom: 1px solid #e2e8f0;
    }
    .hero {
      max-width: 1200px;
      margin: 0 auto;
      padding: 84px 20px 64px;
      display: grid;
      grid-template-columns: 1.12fr 0.88fr;
      gap: 40px;
      align-items: center;
    }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      border: 1px solid #e5e7eb;
      border-radius: 999px;
      background: #fff;
      color: #334155;
      font-weight: 800;
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .hero h1 {
      font-size: clamp(2.15rem, 4vw, 3.25rem);
      font-weight: 950;
      color: #0b1220;
      margin: 0 0 14px;
      letter-spacing: -0.03em;
      line-height: 1.03;
      max-width: 12ch;
    }
    .hero p {
      color: #475569;
      font-size: 1.06rem;
      line-height: 1.82;
      margin: 0 0 22px;
      max-width: 62ch;
    }
    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }
    .hero-meta span {
      display: inline-flex;
      align-items: center;
      padding: 7px 11px;
      border-radius: 999px;
      border: 1px solid #e5e7eb;
      color: #334155;
      background: rgba(255, 255, 255, 0.9);
      font-size: 0.8rem;
      font-weight: 760;
      letter-spacing: 0.03em;
    }
    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 13px 18px;
      border-radius: 10px;
      font-weight: 850;
      text-decoration: none;
      transition: all 0.2s ease;
      border: 1px solid transparent;
      font-size: 0.94rem;
    }
    .btn.primary {
      background: var(--primary-color);
      color: #fff;
      box-shadow: 0 14px 28px color-mix(in srgb, var(--primary-color) 25%, transparent);
    }
    .btn.primary:hover {
      transform: translateY(-1px);
      filter: brightness(0.96);
    }
    .btn.ghost {
      background: #fff;
      color: #0f172a;
      border-color: #e5e7eb;
    }
    .btn.ghost:hover {
      border-color: color-mix(in srgb, var(--primary-color) 45%, #e5e7eb);
      box-shadow: 0 12px 26px rgba(0, 0, 0, 0.06);
      transform: translateY(-1px);
    }

    .hero-card {
      background:
        radial-gradient(800px 340px at 16% 0%, rgba(255, 255, 255, 0.08), transparent 55%),
        #0b1220;
      color: #e5e7eb;
      border-radius: 16px;
      padding: 22px 22px;
      border: 1px solid rgba(148, 163, 184, 0.2);
      box-shadow: 0 30px 70px rgba(2, 6, 23, 0.23);
      position: relative;
      overflow: hidden;
    }
    .hero-card::before {
      content: '';
      position: absolute;
      inset: -40px;
      background: radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.12), transparent 55%);
      pointer-events: none;
    }
    .hero-card h3 {
      margin: 0 0 10px;
      font-size: 1.18rem;
      font-weight: 900;
      color: #fff;
      position: relative;
      letter-spacing: -0.01em;
    }
    .hero-card ul {
      margin: 0;
      padding-left: 18px;
      line-height: 1.78;
      color: #cbd5e1;
      font-size: 0.95rem;
      position: relative;
    }
    .hero-card li {
      margin: 6px 0;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
      padding: 18px 20px 20px;
      max-width: 1200px;
      margin: 0 auto;
    }
    .cat-card {
      text-decoration: none;
      color: inherit;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      overflow: hidden;
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
      background: #fff;
      display: flex;
      flex-direction: column;
    }
    .cat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
        border-color: var(--primary-color);
    }
    .img-wrapper {
      height: 250px;
      background: #f9fafb;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .img-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .img-placeholder {
      color: #9ca3af;
      font-size: 0.95rem;
    }
    .info {
      padding: 20px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .info h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 0 10px;
      color: #111827;
    }
    .info p {
      color: #6b7280;
      font-size: 0.95rem;
      line-height: 1.55;
      margin: 0 0 16px;
      flex: 1;
    }
    .view-btn {
      color: var(--primary-color);
      font-weight: 700;
      margin-top: auto;
      display: inline-block;
    }
    .empty-categories {
      text-align: center;
      padding: 3rem 20px;
      color: #6b7280;
      max-width: 560px;
      margin: 0 auto;
    }

    .section-head {
      max-width: 1200px;
      margin: 0 auto;
      padding: 42px 20px 0;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 18px;
    }
    .section-head h2 {
      margin: 0;
      font-size: 1.8rem;
      font-weight: 950;
      letter-spacing: -0.02em;
      color: #0f172a;
    }
    .section-head p {
      margin: 8px 0 0;
      color: #64748b;
      line-height: 1.7;
      max-width: 68ch;
    }
    .section-head a {
      color: var(--primary-color);
      font-weight: 900;
      text-decoration: none;
      white-space: nowrap;
    }
    .section-head a:hover {
      text-decoration: underline;
    }

    .cta-band {
      max-width: 1200px;
      margin: 50px auto 80px;
      padding: 28px 24px;
      border-radius: 18px;
      border: 1px solid #e5e7eb;
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 16px;
      align-items: center;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.05);
    }
    .cta-band h3 {
      margin: 0 0 6px;
      font-size: 1.35rem;
      font-weight: 950;
      color: #0f172a;
      letter-spacing: -0.02em;
    }
    .cta-band p {
      margin: 0;
      color: #64748b;
      line-height: 1.7;
    }

    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 68px 20px 48px;
        gap: 20px;
      }
      .cta-band {
        grid-template-columns: 1fr;
      }
      .section-head {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <div class="hero-wrap">
    <section class="hero">
      <div>
        <div class="eyebrow">Automotive LED Lighting</div>
        <h1>{heroTitle}</h1>
        <p>{heroSubtitle}</p>
        <div class="hero-meta">
          <span>OEM / ODM Available</span>
          <span>Fast RFQ Response</span>
          <span>Global B2B Supply</span>
        </div>
        <div class="hero-cta">
          <a class="btn primary" href="/products">Browse Products</a>
          <a class="btn ghost" href="/request-quote">Request a Quote</a>
        </div>
      </div>
      <aside class="hero-card" aria-label="Key strengths">
        <h3>Built for B2B partners</h3>
        <ul>
          <li>OEM/ODM support: branding, packaging, and customization</li>
          <li>Stable supply and fast response for projects</li>
          <li>Clear specs, images, and structured product data</li>
        </ul>
      </aside>
    </section>
  </div>

  <header class="section-head">
    <div>
      <h2>Browse by Category</h2>
      <p>Start with a category to explore specifications, images, and inquiry-ready product pages.</p>
    </div>
    <a href="/products">View all products →</a>
  </header>

  {
    categories.length ? (
      <div class="category-grid">
        {categories.map((cat) => (
          <a href={`/category/${cat.pathSlug}`} class="cat-card">
            <div class="img-wrapper">
              {cat.imageUrl ? (
                <img src={cat.imageUrl} alt={cat.title ?? 'Category'} loading="lazy" />
              ) : (
                <span class="img-placeholder">No cover image</span>
              )}
            </div>
            <div class="info">
              <h2>{cat.title}</h2>
              {cat.description ? (
                <p>{cat.description}</p>
              ) : (
                <p>Explore products and open a model for specs, images, and inquiry.</p>
              )}
              <span class="view-btn">
                View Products →{' '}
                <span style="color:#9ca3af; font-weight:800; margin-left:8px;">
                  {cat.count ?? 0}
                </span>
              </span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-categories">
        No categories yet. In Sanity Studio, create <strong>产品分类</strong> (type:{' '}
        <code>productCategory</code>) documents with at least a <strong>title</strong>, then Publish.
        Adding a <strong>Slug</strong> is recommended for stable URLs.
      </p>
    )
  }

  {featuredProducts.length ? (
    <ProductListing
      products={featuredProducts}
      sectionTitle="Featured Products"
      sectionDescription="Latest updated products with inquiry-ready specs and media."
    />
  ) : null}

  <section class="cta-band" aria-label="Inquiry call to action">
    <div>
      <h3>Need a customized lighting solution?</h3>
      <p>
        Tell us your vehicle model, target quantity, and requirements. We’ll respond with options and a
        quotation.
      </p>
    </div>
    <div>
      <a class="btn primary" href="/request-quote">Send Inquiry</a>
    </div>
  </section>
</MainLayout>
